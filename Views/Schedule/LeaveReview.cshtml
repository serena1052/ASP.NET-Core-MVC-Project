@model IEnumerable<project.Models.LeaveRequest>
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>假單審核中心</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            min-height: 100vh;
            font-size: 14px;
            color: #000000 !important;
        }

        .text-primary, .text-secondary, .text-muted, .text-white-50, .text-danger {
            color: #000000 !important;
        }

        .nav-tabs .nav-link {
            font-size: 14px;
            color: #000000 !important;
        }

            .nav-tabs .nav-link.active {
                font-weight: bold;
                border-bottom: 3px solid #2b3a4a;
                color: #000000 !important;
            }

        .table th {
            font-size: 14px;
            padding: 12px 6px !important;
            color: #000000 !important;
            border-color: #cbd5e1 !important;
            background-color: #f1f5f9 !important;
        }

        .table td {
            font-size: 14px;
            color: #000000 !important;
            border-color: #cbd5e1 !important;
        }

        .navbar-brand, .navbar-text, h4, h5, h6, label {
            color: #000000 !important;
        }

        .btn-logout {
            background-color: #2b3a4a !important;
            color: #ffffff !important;
            border: none;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

            .btn-logout:hover {
                background-color: #41566b !important;
                color: #ffffff !important;
            }

        .btn-approve {
            background-color: #2b3a4a !important;
            color: #ffffff !important;
            border: none;
            border-radius: 4px;
            padding: 5px 12px;
            font-size: 13px;
            transition: all 0.3s ease;
        }

            .btn-approve:hover {
                background-color: #41566b !important;
                color: #ffffff !important;
            }

        .btn-reject {
            color: #2b3a4a !important;
            border-color: #cbd5e1 !important;
            background-color: #ffffff !important;
            border-radius: 4px;
            padding: 5px 12px;
            font-size: 13px;
        }

            .btn-reject:hover {
                background-color: #f1f5f9 !important;
                color: #2b3a4a !important;
            }

        .badge {
            color: #000000 !important;
            font-weight: normal;
            font-size: 13px;
            padding: 6px 10px;
            border-radius: 4px;
        }

        .badge-status {
            background-color: #e2e8f0 !important;
            border-left: 3px solid #2b3a4a;
        }

        .badge-history-approved {
            background-color: #f0fdf4 !important;
            border-left: 3px solid #16a34a;
        }

        .badge-history-other {
            background-color: #f8fafc !important;
            border: 1px solid #cbd5e1;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container-fluid mx-4">
            <a class="navbar-brand fw-bold fs-5" href="#">營運系統</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav nav-tabs border-bottom-0">
                    <li class="nav-item"><a class="nav-link" href="/Schedule/ManagerDashboard">每週指派排班表</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Schedule/AttendanceReport">考勤打卡與統計圖表</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Schedule/LeaveReview">請假審核專區</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Schedule/EmployeeIndex">員工增刪改查</a></li>
                </ul>
                <span class="navbar-text me-3 fw-bold small">主管: @Context.Session.GetString("Name")</span>
                <a href="/Schedule/Logout" class="btn btn-sm btn-logout px-3">登出系統</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card p-4 shadow-sm mb-4" style="background: rgba(255, 255, 255, 0.75); border: none; border-radius: 12px;">
            <h4 class="fw-bold mb-4 fs-4">請假審核專區</h4>

            <div class="mb-4">
                <h5 class="fw-bold mb-3 fs-5">收到待處理請假申請單</h5>
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-3 mb-0 bg-white rounded shadow-sm border border-light">目前沒有需要審核的員工請假單。</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center bg-white shadow-sm" style="border-radius: 8px; overflow: hidden;">
                            <thead>
                                <tr>
                                    <th>員工姓名</th>
                                    <th>預計請假日期</th>
                                    <th>請假類別/原因</th>
                                    <th>審核操作決策</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lr in Model)
                                {
                                    <tr>
                                        <td><strong>@lr.Employee?.name</strong> (工號:@lr.emp_id)</td>
                                        <td class="fw-bold">@lr.leave_date.ToString("yyyy-MM-dd")</td>
                                        <td><span class="badge badge-status">@lr.leave_type</span></td>
                                        <td>
                                            <form action="/Schedule/ReviewLeave" method="post" class="d-inline mx-1">
                                                <input type="hidden" name="leaveId" value="@lr.leave_id">
                                                <button type="submit" name="action" value="Approve" class="btn btn-approve btn-sm fw-bold me-1">同意核准</button>
                                                <button type="submit" name="action" value="Reject" class="btn btn-reject btn-sm">拒絕駁回</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="mt-2">
                <h6 class="fw-bold mb-3 fs-5">歷史假單審核紀錄審查</h6>
                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle bg-white shadow-sm" style="border-radius: 8px; overflow: hidden;">
                        <thead>
                            <tr>
                                <th>員工姓名</th>
                                <th>請假日期</th>
                                <th>假別</th>
                                <th>最終審核狀態</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in ViewBag.HistoryLeaves)
                            {
                                var isApproved = history.status == "Approved" || history.status == "已核准";
                                <tr>
                                    <td><span class="fw-semibold">@history.Employee?.name</span></td>
                                    <td>@history.leave_date.ToString("yyyy-MM-dd")</td>
                                    <td>@history.leave_type</td>
                                    <td>
                                        <span class="badge @(isApproved ? "badge-history-approved" : "badge-history-other")">
                                            @(history.status == "Approved" ? "已核准" : (history.status == "Rejected" ? "已拒絕" : history.status))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</body>
</html>