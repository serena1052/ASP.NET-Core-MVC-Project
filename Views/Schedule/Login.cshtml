@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>歡迎登入 - 餐廳工作排班管理系統</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            /* 🟢 完美維持與主頁完全一致的淡雅莫蘭迪灰藍漸層背景 */
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* 🟢 徹底拿掉卡片框框，讓容器完全透明，欄位直接飄在背景上 */
        .login-container {
            background: transparent;
            width: 420px;
            margin: 0 auto;
        }

        /* 🟢 標題採用與主頁一樣的深卡其藍色 */
        .login-title {
            color: #2b3a4a;
            letter-spacing: 2px;
            font-size: 2.5rem;
        }

        .form-label {
            color: #3a4750;
            font-weight: bold;
            font-size: 0.95rem;
        }

        /* 🟢 與主頁完全一致的莫蘭迪深藍色按鈕 */
        .btn-custom-primary {
            background-color: #2b3a4a;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-size: 1.1rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

            .btn-custom-primary:hover {
                background-color: #41566b;
                color: #ffffff;
                transform: translateY(-1px);
            }

        .btn-custom-outline {
            border: 1px solid #2b3a4a;
            color: #2b3a4a;
            background-color: transparent;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

            .btn-custom-outline:hover {
                background-color: #2b3a4a;
                color: #ffffff;
            }

        .form-control {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 0.75rem 1rem;
        }

            .form-control:focus {
                border-color: #41566b;
                box-shadow: 0 0 0 0.25rem rgba(43, 58, 74, 0.12);
            }
    </style>
</head>
<body>

    <div class="login-container">

        <div class="text-center mb-5">
            <h2 class="fw-bold login-title">歡迎登入</h2>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small text-center mb-4" style="border-radius: 6px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.2);">
                ⚠️ @ViewBag.Error
            </div>
        }

        <form method="post" action="/Schedule/Login">
            <div class="mb-4">
                <label class="form-label mb-2">工號</label>
                <input type="number" name="emp_id" class="form-control" placeholder="請輸入您的工號" required />
            </div>

            <div class="mb-5">
                <label class="form-label mb-2">電話號碼</label>
                <input type="password" name="password" class="form-control" placeholder="請輸入您的電話號碼" required />
            </div>

            <button type="submit" class="btn btn-custom-primary w-100 fw-bold py-3 mb-3 shadow-sm">
                登入 ➔
            </button>

            <a href="/Schedule/Register" class="btn btn-custom-outline w-100 btn-sm py-2 fw-semibold">
                新員工註冊綁定
            </a>
        </form>

    </div>

</body>
</html>