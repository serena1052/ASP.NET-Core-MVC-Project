@model IEnumerable<project.Models.Schedule>
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>每週排班時間表</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            min-height: 100vh;
            font-size: 14px;
            color: #000000 !important;
            font-family: 'SF Pro Display', -apple-system, sans-serif;
        }

        .text-primary, .text-secondary, .text-muted, .text-white-50 {
            color: #000000 !important;
        }

        .nav-tabs .nav-link {
            font-size: 14px;
            color: #000000 !important;
        }

            .nav-tabs .nav-link.active {
                font-weight: bold;
                border-bottom: 3px solid #2b3a4a;
                color: #000000 !important;
                background: none;
            }

            .nav-tabs .nav-link:hover {
                color: #2b3a4a !important;
                border-bottom: 3px solid #cbd5e1;
            }

        .card {
            border: none;
            border-radius: 12px;
        }

        .drop-bucket {
            min-height: 120px;
            background: rgba(255, 255, 255, 0.2);
            padding: 4px;
            border-radius: 8px;
        }

        .job-category-group {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid #cbd5e1;
            border-left: 3px solid #2b3a4a;
            border-radius: 6px;
            padding: 6px;
            margin-bottom: 8px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
        }

        .job-category-header {
            font-size: 11px;
            font-weight: 700;
            color: #2b3a4a;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            padding-bottom: 2px;
            border-bottom: 1px solid rgba(203, 213, 225, 0.4);
            text-align: left;
        }

        .sched-box {
            padding: 6px 8px;
            margin: 4px 0;
            border-radius: 4px;
            font-size: 13px;
            color: #000000 !important;
            background: #e2e8f0 !important;
            border-left: 4px solid #2b3a4a;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
            line-height: 1.3;
        }

            .sched-box.bg-success {
                background: #e2e8f0 !important;
            }

            .sched-box.bg-warning {
                background: #fffbeb !important;
                border-left: 4px solid #d97706;
            }

            .sched-box.bg-danger {
                background: #fef2f2 !important;
                border-left: 4px solid #dc2626;
            }

            .sched-box strong, .sched-box div, .sched-box span, .sched-box a {
                color: #000000 !important;
            }

        .table th {
            font-size: 14px;
            padding: 12px 6px !important;
            color: #000000 !important;
            border-color: #cbd5e1 !important;
        }

        .table td {
            font-size: 14px;
            color: #000000 !important;
            border-color: #cbd5e1 !important;
            padding: 8px !important;
            vertical-align: top;
        }

        .form-select, .form-control {
            font-size: 14px !important;
            color: #000000 !important;
        }

        optgroup, option {
            font-size: 14px;
            color: #000000 !important;
        }

        .navbar-brand, .navbar-text, h4, h5, label {
            color: #000000 !important;
        }

        .btn-outline-primary {
            color: #2b3a4a !important;
            border-color: #cbd5e1 !important;
            background-color: #ffffff !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

            .btn-outline-primary:hover {
                background-color: #2b3a4a !important;
                border-color: #2b3a4a !important;
                color: #ffffff !important;
            }

        .btn-logout {
            background-color: #2b3a4a !important;
            color: #ffffff !important;
            border: none;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

            .btn-logout:hover {
                background-color: #41566b !important;
                color: #ffffff !important;
            }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container-fluid mx-4">
            <a class="navbar-brand fw-bold fs-5" href="#">營運系統</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav nav-tabs border-bottom-0">
                    <li class="nav-item"><a class="nav-link active" href="/Schedule/ManagerDashboard">每週指派排班表</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Schedule/AttendanceReport">考勤打卡與統計圖表</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Schedule/LeaveReview">請假審核專區</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Schedule/EmployeeIndex">員工增刪改查</a></li>
                </ul>
                <span class="navbar-text me-3 fw-bold small">主管: @Context.Session.GetString("Name")</span>
                <a href="/Schedule/Logout" class="btn btn-sm btn-logout px-3">登出系統</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card p-4 shadow-sm" style="background: rgba(255, 255, 255, 0.75); border: none; border-radius: 12px;">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0 fs-4">每週排班時間表</h4>

                <form method="get" action="/Schedule/ManagerDashboard" class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold text-nowrap small mb-0">選擇週別：</label>
                        <input type="week" name="week" value="@ViewBag.SelectedWeek" onchange="this.form.submit()" class="form-control form-control-sm" style="width: 160px; background: #ffffff;">
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold text-nowrap small mb-0">篩選特定員工：</label>
                        <select name="searchEmpId" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 180px;">
                            <!option value="">顯示全體排班</!option>
                            @foreach (var emp in ViewBag.Employees)
                            {
                                bool isEmpSelected = ViewBag.SelectedEmpId == emp.emp_id;
                                <!option value="@emp.emp_id" @(isEmpSelected ? "selected" : "")>@emp.name (@emp.job_title)</!option>
                            }
                        </select>
                    </div>
                </form>
            </div>

            <table class="table table-bordered align-middle bg-white shadow-sm" style="border-radius: 8px; overflow: hidden;">
                <thead class="text-center" style="background-color: #f1f5f9;">
                    <tr>
                        <th style="width: 12%; background-color: #f1f5f9;">班別時段</th>
                        @foreach (DateTime dt in ViewBag.WeekDates)
                        {
                            <th style="background-color: #f1f5f9;"><span class="fs-6 fw-bold">@dt.ToString("MM/dd")</span><br><small class="fw-normal">@dt.ToString("ddd")</small></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in ViewBag.TimeSlots)
                    {
                        <tr>
                            <td class="bg-light fw-bold text-center fs-6">@slot.slot_name</td>
                            @foreach (DateTime dt in ViewBag.WeekDates)
                            {
                                var dateStr = dt.ToString("yyyy-MM-dd");
                                <td>
                                    <div class="drop-bucket">
                                        <button class="btn btn-outline-primary btn-sm py-1 px-2 mb-2 w-100 fw-bold fs-7" onclick="clickToAssign('@dateStr', @slot.slot_id, '@slot.slot_name')">+ 指派排班</button>

                                        @{
                                            var orderMap = new Dictionary<string, int> {
                                                                { "Manager", 1 },
                                                                { "內場廚師", 2 },
                                                                { "外場服務員", 3 },
                                                                { "收銀人員", 4 },
                                                                { "清潔人員", 5 }
                                                                };

                                            var daySchedulesGrouped = Model
                                            .Where(s => s.sche_date.ToString("yyyy-MM-dd") == dateStr && s.slot_id == slot.slot_id)
                                            .GroupBy(s => s.Employee?.job_title ?? "未設定崗位")
                                            .OrderBy(g => orderMap.ContainsKey(g.Key) ? orderMap[g.Key] : 99);
                                        }

                                        @foreach (var group in daySchedulesGrouped)
                                        {
                                            <div class="job-category-group">
                                                <div class="job-category-header">@group.Key</div>

                                                @foreach (var item in group)
                                                {
                                                    var currentStatus = item.status ?? "";
                                                    var color = (currentStatus == "Late" || currentStatus.Contains("遲到")) ? "warning" : ((currentStatus == "Leave" || currentStatus == "已請假") ? "danger" : "success");

                                                    var displayStatus = currentStatus;
                                                    if (currentStatus == "Scheduled")
                                                    {
                                                        displayStatus = "已排班";
                                                    }

                                                    displayStatus = displayStatus.Replace("(元智一館)", "").Replace("元智一館", "").Trim();

                                                    <div class="sched-box bg-@color">
                                                        <strong style="font-size: 13px;">@(item.Employee != null ? item.Employee.name : "未命名員工")</strong>
                                                        <div class="opacity-75" style="font-size: 10.5px; margin-top: 1px;">狀態: <span class="fw-bold">@displayStatus</span></div>
                                                        <div class="text-end" style="margin-top: 2px;"><a href="/Schedule/DeleteSchedule?id=@item.sche_id" class="text-decoration-none small opacity-50" style="font-size: 10px;" onclick="return confirm('移除排班？')">移除排班</a></div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="clickAssignModal" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); background:white; padding:25px; box-shadow:0 0 25px rgba(0,0,0,0.15); border-radius:12px; z-index:9999; width:380px; font-family: system-ui, sans-serif;">
        <h5 class="fw-bold mb-2">指派班次人員</h5>
        <p id="modalSlotTitle" class="fw-bold mb-3 fs-6" style="color: #2b3a4a !important;"></p>

        <input type="hidden" id="modalDate">
        <input type="hidden" id="modalSlotId">

        <div class="mb-4">
            <label class="form-label fw-bold small">請選擇員工：</label>
            <select id="modalEmpSelect" class="form-select form-select-sm" style="padding: 8px; border-radius: 6px;">
            </select>
        </div>

        <div class="text-end gap-2 d-flex justify-content-end">
            <button class="btn btn-light btn-sm px-3 py-1 fw-semibold" onclick="document.getElementById('clickAssignModal').style.display='none'">取消</button>
            <button class="btn btn-primary btn-sm px-3 py-1 fw-bold" id="btnSubmitAssign" style="background-color: #2b3a4a; border: none; color: #ffffff !important;" onclick="submitClickAssign()">確認指派</button>
        </div>
    </div>

    <script>
        const allEmployees = @Html.Raw(Json.Serialize(ViewBag.Employees));

        function clickToAssign(date, slotId, slotName) {
            document.getElementById('modalDate').value = date;
            document.getElementById('modalSlotId').value = slotId;

            var cleanSlotName = slotName.split(' ')[0].split('(')[0];
            document.getElementById('modalSlotTitle').innerText = `您正在指派：${cleanSlotName}`;

            const select = document.getElementById('modalEmpSelect');
            select.innerHTML = "";

            if (!allEmployees || allEmployees.length === 0) {
                select.innerHTML = `<option value="">系統內無可用員工資料</option>`;
                document.getElementById('btnSubmitAssign').disabled = true;
                document.getElementById('clickAssignModal').style.display = 'block';
                return;
            }
            const filteredEmployees = allEmployees.filter(e => {
                const jobTitle = String(e.job_title || e.jobTitle || "").trim();
                const employeeName = String(e.name || e.Name || "");
                const empType = String(e.employment_type || e.employmentType || jobTitle).trim();

                if (slotName.includes("早班")) {
                    return !empType.includes("晚班");
                }

                if (slotName.includes("晚班")) {
                    return !empType.includes("早班");
                }

                return true;
            });

            const orderRules = { "Manager": 1, "內場廚師": 2, "外場服務員": 3, "收銀人員": 4, "清潔人員": 5 };
            const groups = {};
            filteredEmployees.forEach(e => {
                const role = (e.job_title || e.jobTitle || "一般店員").trim();
                if (!groups[role]) {
                    groups[role] = [];
                }
                groups[role].push(e);
            });

            const sortedGroupNames = Object.keys(groups).sort((a, b) => {
                return (orderRules[a] || 99) - (orderRules[b] || 99);
            });

            let hasEmployees = false;
            sortedGroupNames.forEach(groupName => {
                let optGroupHtml = `<optgroup label="工作崗位：${groupName}">`;
                groups[groupName].forEach(e => {
                    hasEmployees = true;
                    const nameText = e.name || e.Name || "未命名";
                    const idValue = e.emp_id || e.empId;
                    const posValue = e.pos_id || e.posId || 1;

                    optGroupHtml += `<option value="${idValue}" data-pos="${posValue}">${nameText}</option>`;
                });
                boxHtml = `</optgroup>`;
                select.innerHTML += optGroupHtml;
            });

            if (!hasEmployees) {
                select.innerHTML = `<option value="">此時段無符合班別的可用店員</option>`;
                document.getElementById('btnSubmitAssign').disabled = true;
            } else {
                document.getElementById('btnSubmitAssign').disabled = false;
            }

            document.getElementById('clickAssignModal').style.display = 'block';
        }

        function submitClickAssign() {
            const selectEl = document.getElementById('modalEmpSelect');
            const empId = selectEl.value;
            if(!empId) { alert("請選擇有效員工！"); return; }

            const selectedOption = selectEl.options[selectEl.selectedIndex];
            const realPosId = parseInt(selectedOption.getAttribute('data-pos') || "1");

            fetch('/Schedule/AssignSchedule', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    EmpId: parseInt(empId),
                    PosId: realPosId,
                    Date: document.getElementById('modalDate').value,
                    SlotId: parseInt(document.getElementById('modalSlotId').value)
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    window.location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
</body>
</html>